# Non-secret parameters for the iKeepZ functions. Copy to `.env.<your-project-id>` (git-ignored) next to this file
# before deploying, or let `firebase deploy` prompt for them. Every value is optional; the defaults are shown.
#
# Secrets (PAYMONGO_SECRET_KEY, PAYMONGO_WEBHOOK_SECRET) are NOT stored here: they live in Secret Manager
# (`firebase functions:secrets:set NAME`, or the "Deploy backend" GitHub workflow).

# https URL of backend/public/payment-return.html on Firebase Hosting. Deposits stay disabled while empty.
# Example: https://my-project.web.app/payment-return.html
PUBLIC_RETURN_URL=

# Currencies new wallets may use (comma separated). PayMongo checkout is PHP only.
WALLET_CURRENCIES=PHP

# Per-operation limits in minor units (PHP 100.00 = 10000).
DEPOSIT_MIN_MINOR=10000
DEPOSIT_MAX_MINOR=5000000
WITHDRAW_MIN_MINOR=10000
WITHDRAW_MAX_MINOR=5000000
TRANSFER_MIN_MINOR=100
TRANSFER_MAX_MINOR=5000000

# Withdrawals + transfers out per local day, per user (minor units), and what "a day" means.
DAILY_OUT_LIMIT_MINOR=10000000
LIMIT_TZ_OFFSET_MINUTES=480

# Fees: fee = round_half_up(amount * BPS / 10000) + FIXED. Deposit fee is charged on top at checkout;
# withdrawal and transfer fees are deducted from the wallet in addition to the amount.
DEPOSIT_FEE_BPS=0
DEPOSIT_FEE_FIXED_MINOR=0
WITHDRAW_FEE_BPS=0
WITHDRAW_FEE_FIXED_MINOR=0
TRANSFER_FEE_BPS=0
TRANSFER_FEE_FIXED_MINOR=0

# Wallet PIN lockout.
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# When true, users/{uid}.kycStatus must be "approved" before they can withdraw.
REQUIRE_KYC_FOR_WITHDRAWAL=false

# Payment methods offered on the PayMongo checkout page (must be enabled on your PayMongo account).
PAYMENT_METHODS=gcash,paymaya,card
